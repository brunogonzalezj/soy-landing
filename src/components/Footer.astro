---
import { Facebook, Twitter, Linkedin, Instagram } from 'lucide-react';

const SOCIAL_LINKS = [
  { name: 'Facebook', icon: Facebook, href: '#facebook' },
  { name: 'Twitter', icon: Twitter, href: '#twitter' },
  { name: 'LinkedIn', icon: Linkedin, href: '#linkedin' },
  { name: 'Instagram', icon: Instagram, href: '#instagram' },
];
---

<footer class="bg-forest text-white">
  <div class="container mx-auto px-4">
    {/* Main Footer Content */}
    <div class="py-16 border-b border-white/10">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-3 gap-10 items-center">
          {/* Logo - Left */}
          <div>
            <img
              src="/images/Iso SOY.svg"
              alt="Soy Excellence Center"
              class="h-16 w-auto"
            />
          </div>

          {/* Newsletter - Center */}
          <div>
            <span class="block text-xs uppercase tracking-[0.2em] text-white/50 font-bold mb-3" data-i18n="footer.subscribe">Subscribe to our newsletter</span>
            <form class="flex gap-0 border border-white/20 focus-within:border-sec-yellow transition-colors duration-300">
              <input
                type="email"
                placeholder="Your email"
                data-i18n-placeholder="footer.emailPlaceholder"
                class="flex-1 min-w-0 px-4 py-3 bg-transparent text-white placeholder-white/40 focus:outline-none"
                aria-label="Email address"
              />
              <button
                type="submit"
                class="px-6 py-3 bg-sec-yellow text-ink font-bold text-sm uppercase tracking-wide hover:bg-white transition-colors duration-300 whitespace-nowrap"
              >
                <span data-i18n="footer.subscribeButton">Subscribe</span>
              </button>
            </form>
          </div>

          {/* Contact Us Button - Right */}
          <div class="flex justify-start md:justify-end">
            <a href="/contact" class="btn-outline-light">
              <span data-i18n="footer.contactUs">Contact Us</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="py-6">
      <div class="flex flex-col md:flex-row items-center justify-center gap-6 text-sm text-white/50">
        {/* Social Media Icons with Label */}
        <div class="flex items-center gap-3">
          <span class="text-white/50" data-i18n="footer.followUs">Follow Us:</span>
          {SOCIAL_LINKS.map((social) => {
            const Icon = social.icon;
            return (
              <a
                key={social.name}
                href={social.href}
                class="w-9 h-9 rounded-sm border border-white/20 hover:border-sec-yellow hover:text-sec-yellow flex items-center justify-center transition-colors duration-300"
                aria-label={social.name}
              >
                <Icon size={17} />
              </a>
            );
          })}
        </div>

        {/* Separator */}
        <div class="hidden md:block w-px h-4 bg-white/20"></div>

        {/* Copyright */}
        <span data-i18n="footer.copyright">© 2026 Soy Excellence Center. All rights reserved.</span>

        {/* Separator */}
        <div class="hidden md:block w-px h-4 bg-white/20"></div>

        {/* Legal Links */}
        <div class="flex items-center gap-6">
          <a href="#privacy" class="link-underline hover:text-sec-yellow transition-colors duration-300">
            <span data-i18n="footer.privacyPolicy">Privacy Policy</span>
          </a>
          <a href="#terms" class="link-underline hover:text-sec-yellow transition-colors duration-300">
            <span data-i18n="footer.termsOfService">Terms of Service</span>
          </a>
          <a href="#cookies" class="link-underline hover:text-sec-yellow transition-colors duration-300">
            <span data-i18n="footer.cookiePolicy">Cookie Policy</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
