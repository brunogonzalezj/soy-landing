---
import Layout from '../layouts/Layout.astro';
import {
  BookOpen,
  Users,
  MessageSquare,
  Flag,
  Sparkles,
  Handshake,
  Star,
  Building2,
  Briefcase,
  Heart,
  Globe,
} from 'lucide-react';

const STEPS = [
  {
    number: '01',
    labelKey: 'howWeOperate.step1.label',
    titleKey: 'howWeOperate.step1.title',
    descriptionKey: 'howWeOperate.step1.description',
    icon: BookOpen,
  },
  {
    number: '02',
    labelKey: 'howWeOperate.step2.label',
    titleKey: 'howWeOperate.step2.title',
    descriptionKey: 'howWeOperate.step2.description',
    icon: Users,
  },
  {
    number: '03',
    labelKey: 'howWeOperate.step3.label',
    titleKey: 'howWeOperate.step3.title',
    descriptionKey: 'howWeOperate.step3.description',
    icon: MessageSquare,
  },
  {
    number: '04',
    labelKey: 'howWeOperate.step4.label',
    titleKey: 'howWeOperate.step4.title',
    descriptionKey: 'howWeOperate.step4.description',
    icon: Flag,
  },
  {
    number: '06',
    labelKey: 'howWeOperate.step6.label',
    titleKey: 'howWeOperate.step6.title',
    descriptionKey: 'howWeOperate.step6.description',
    icon: Handshake,
  },
  {
    number: '07',
    labelKey: 'howWeOperate.step7.label',
    titleKey: 'howWeOperate.step7.title',
    descriptionKey: 'howWeOperate.step7.description',
    icon: Star,
  },
];

const IMPACT_AREAS = [
  { titleKey: 'howWeOperate.step5.company.title', descriptionKey: 'howWeOperate.step5.company.description', icon: Building2 },
  { titleKey: 'howWeOperate.step5.career.title', descriptionKey: 'howWeOperate.step5.career.description', icon: Briefcase },
  { titleKey: 'howWeOperate.step5.personal.title', descriptionKey: 'howWeOperate.step5.personal.description', icon: Heart },
  { titleKey: 'howWeOperate.step5.industry.title', descriptionKey: 'howWeOperate.step5.industry.description', icon: Globe },
];
---

<Layout title="How We Operate - Soy Excellence Center">
  <section class="py-20 md:py-28 bg-white">
    <div class="container mx-auto px-4">
      {/* Header */}
      <div class="max-w-3xl mb-16 md:mb-20 scroll-reveal-section">
        <span class="eyebrow mb-5">
          <span class="eyebrow-rule"></span>
          <span data-i18n="howWeOperate.badge">About SEC</span>
        </span>
        <h1 class="text-4xl md:text-6xl text-ink mb-6 leading-[1.05]" data-i18n="howWeOperate.title">
          How We Operate
        </h1>
        <p class="text-lg md:text-xl text-ink/60 leading-relaxed" data-i18n="howWeOperate.subtitle">
          The SEC Journey: a step-by-step path from foundational learning to community leadership.
        </p>
      </div>

      {/* SEC Journey */}
      <div class="mb-16 scroll-reveal-section">
        <div class="max-w-2xl mb-12 scroll-reveal-item">
          <h2 class="text-3xl md:text-4xl text-ink mb-4" data-i18n="howWeOperate.journey.title">The SEC Journey</h2>
          <p class="text-lg text-ink/60" data-i18n="howWeOperate.journey.subtitle">
            Every member advances through the same path, from building fundamentals to inspiring the next generation of leaders.
          </p>
        </div>

        <div class="border-t border-line">
          {STEPS.map((step, index) => {
            const Icon = step.icon;
            const isImpactStep = index === 3;
            return (
              <>
                <div
                  class="scroll-reveal-item flex flex-col md:flex-row gap-6 md:gap-10 border-b border-line py-10"
                  style={`transition-delay: ${index * 80}ms;`}
                >
                  <div class="flex items-start gap-5 md:w-64 flex-shrink-0">
                    <span class="index-num text-3xl">{step.number}</span>
                    <div class="icon-tile">
                      <Icon size={22} />
                    </div>
                  </div>
                  <div class="flex-1">
                    <span class="block text-xs font-bold uppercase tracking-[0.2em] text-ussec-green mb-2" data-i18n={step.labelKey}></span>
                    <h3 class="text-xl md:text-2xl font-bold text-ink mb-3" data-i18n={step.titleKey}></h3>
                    <p class="text-ink/60 leading-relaxed max-w-2xl" data-i18n={step.descriptionKey}></p>
                  </div>
                </div>

                {isImpactStep && (
                  <div class="border-b border-line py-10 bg-paper -mx-4 px-4 md:mx-0 md:px-10">
                    <div class="flex items-start gap-5 md:gap-10 flex-col md:flex-row">
                      <div class="flex items-start gap-5 md:w-64 flex-shrink-0">
                        <span class="index-num text-3xl">05</span>
                        <div class="icon-tile bg-white">
                          <Sparkles size={22} />
                        </div>
                      </div>
                      <div class="flex-1">
                        <span class="block text-xs font-bold uppercase tracking-[0.2em] text-ussec-green mb-2" data-i18n="howWeOperate.step5.label"></span>
                        <h3 class="text-xl md:text-2xl font-bold text-ink mb-3" data-i18n="howWeOperate.step5.title"></h3>
                        <p class="text-ink/60 leading-relaxed max-w-2xl mb-8" data-i18n="howWeOperate.step5.description"></p>

                        <div class="grid sm:grid-cols-2 gap-px bg-line max-w-2xl">
                          {IMPACT_AREAS.map((area) => {
                            const AreaIcon = area.icon;
                            return (
                              <div class="bg-white p-5">
                                <AreaIcon size={18} class="text-sec-yellow mb-3" />
                                <h4 class="font-bold text-ink text-sm mb-1" data-i18n={area.titleKey}></h4>
                                <p class="text-ink/50 text-xs leading-relaxed" data-i18n={area.descriptionKey}></p>
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import translationsData from '../i18n/translations.json';

  let translations = {};

  // Apply translations (bundled at build time, no network round trip)
  function loadPageTranslations() {
    const lang = localStorage.getItem('preferredLanguage') || 'en';
    translations = translationsData[lang] || {};
    applyPageTranslations();
  }

  // Apply translations to all elements
  function applyPageTranslations() {
    const elements = document.querySelectorAll('[data-i18n]');
    elements.forEach(element => {
      const key = element.getAttribute('data-i18n');
      if (translations[key]) {
        element.textContent = translations[key];
      }
    });
  }

  function initScrollReveal() {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const scrollItems = document.querySelectorAll('.scroll-reveal-item');
    scrollItems.forEach(item => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(40px)';
      item.style.transition = 'opacity 0.8s ease-out, transform 0.8s ease-out';
      observer.observe(item);
    });
  }

  // Initialize on page load
  function initPage() {
    loadPageTranslations();
    initScrollReveal();
  }

  // Listen for language changes
  window.addEventListener('languageChange', loadPageTranslations);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
</script>

<style>
  .scroll-reveal-item.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>
