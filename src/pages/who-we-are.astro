---
import Layout from '../layouts/Layout.astro';
import { Play, Landmark, ShieldCheck, Sprout } from 'lucide-react';

const PARTNERS = [
  { icon: Landmark, nameKey: 'whoWeAre.partners.qssb' },
  { icon: ShieldCheck, nameKey: 'whoWeAre.partners.usda' },
  { icon: Sprout, nameKey: 'whoWeAre.partners.usb' },
];
---

<Layout title="Who We Are - Soy Excellence Center">
  <section class="py-20 md:py-28 bg-white">
    <div class="container mx-auto px-4">
      {/* Header */}
      <div class="max-w-3xl mb-16 md:mb-20 scroll-reveal-section">
        <span class="eyebrow mb-5">
          <span class="eyebrow-rule"></span>
          <span data-i18n="whoWeAre.badge">About SEC</span>
        </span>
        <h1 class="text-4xl md:text-6xl text-ink mb-6 leading-[1.05]" data-i18n="whoWeAre.title">
          Who We Are
        </h1>
        <p class="text-lg md:text-xl text-ink/60 leading-relaxed" data-i18n="whoWeAre.subtitle">
          An educational initiative building the capacity of the agribusiness and protein supply chain workforce.
        </p>
      </div>

      {/* Description + Video */}
      <div class="mb-20 md:mb-28 scroll-reveal-section">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div class="scroll-reveal-item space-y-6">
            <p class="text-lg text-ink/70 leading-relaxed" data-i18n="whoWeAre.description1">
              The Soy Excellence Center (SEC) is an educational initiative launched by the U.S. Soybean Export Council (USSEC) to build the capacity of entry-level and mid-level professionals in the agribusiness and protein supply chain. It combines technical training, continuing education, access to experts, and community building, with the goal of enhancing the workforce's skills and training the next generation of leaders in the sector.
            </p>
            <p class="text-lg text-ink/70 leading-relaxed" data-i18n="whoWeAre.description2">
              Since our launch in 2019, our efforts have expanded into various regions and address local staff development needs. We believe that promoting education and excellence in emerging markets is a first step toward creating prosperity. Our professional development efforts and alumni networking activities enable individuals to advance in their careers.
            </p>
          </div>

          <div class="scroll-reveal-item" style="transition-delay: 150ms;">
            <button
              type="button"
              class="group relative w-full aspect-video overflow-hidden bg-forest"
              aria-label="Play SEC overview video"
            >
              <div
                class="absolute inset-0 opacity-20 bg-cover bg-center"
                style="background-image: url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1200&h=800&fit=crop');"
              ></div>
              <div class="absolute inset-0 bg-gradient-to-t from-forest via-forest/40 to-forest/10"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="w-20 h-20 rounded-full bg-sec-yellow flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                  <Play size={28} class="text-ink ml-1" fill="currentColor" />
                </span>
              </div>
              <span
                class="absolute bottom-5 left-5 text-white text-xs font-bold uppercase tracking-[0.2em]"
                data-i18n="whoWeAre.video.title"
              >
                SEC Overview
              </span>
            </button>
          </div>
        </div>
      </div>

      {/* Partners / Supporters */}
      <div class="scroll-reveal-section">
        <div class="bg-paper p-8 md:p-14">
          <div class="max-w-2xl mb-10 scroll-reveal-item">
            <span class="eyebrow mb-4">
              <span class="eyebrow-rule"></span>
              <span data-i18n="whoWeAre.partners.badge">Partners &amp; Supporters</span>
            </span>
            <h2 class="text-3xl md:text-4xl text-ink mb-4" data-i18n="whoWeAre.partners.title">Partners &amp; Supporters</h2>
            <p class="text-lg text-ink/60 leading-relaxed" data-i18n="whoWeAre.partners.description">
              The SEC's work is strengthened through the leadership and investment of Qualified State Soybean Boards committed to advancing sustainable U.S. Soy worldwide. We are also supported and encouraged by the United States Department of Agriculture and the United Soybean Board.
            </p>
          </div>

          <div class="grid sm:grid-cols-3 gap-px bg-line">
            {PARTNERS.map((partner, index) => {
              const Icon = partner.icon;
              return (
                <div class="scroll-reveal-item bg-white p-8 flex flex-col items-center text-center gap-4" style={`transition-delay: ${index * 100}ms;`}>
                  <div class="icon-tile">
                    <Icon size={22} />
                  </div>
                  <p class="font-bold text-ink text-sm" data-i18n={partner.nameKey}></p>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import translationsData from '../i18n/translations.json';

  let translations = {};

  // Apply translations (bundled at build time, no network round trip)
  function loadPageTranslations() {
    const lang = localStorage.getItem('preferredLanguage') || 'en';
    translations = translationsData[lang] || {};
    applyPageTranslations();
  }

  // Apply translations to all elements
  function applyPageTranslations() {
    const elements = document.querySelectorAll('[data-i18n]');
    elements.forEach(element => {
      const key = element.getAttribute('data-i18n');
      if (translations[key]) {
        element.textContent = translations[key];
      }
    });
  }

  function initScrollReveal() {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const scrollItems = document.querySelectorAll('.scroll-reveal-item');
    scrollItems.forEach(item => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(40px)';
      item.style.transition = 'opacity 0.8s ease-out, transform 0.8s ease-out';
      observer.observe(item);
    });
  }

  // Initialize on page load
  function initPage() {
    loadPageTranslations();
    initScrollReveal();
  }

  // Listen for language changes
  window.addEventListener('languageChange', loadPageTranslations);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
</script>

<style>
  .scroll-reveal-item.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>
