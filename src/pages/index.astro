---
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.jsx';
import WhatWeOffer from '../components/WhatWeOffer.astro';
import Statistics from '../components/Statistics.jsx';
import { MapPin, ArrowRight, Globe } from 'lucide-react';

const EVENTS = [
  { day: '15', month: 'MAR', titleKey: 'events.event1.title', locationKey: 'events.event1.location', descriptionKey: 'events.event1.description' },
  { day: '22', month: 'APR', titleKey: 'events.event2.title', locationKey: 'events.event2.location', descriptionKey: 'events.event2.description' },
  { day: '08', month: 'JUN', titleKey: 'events.event3.title', locationKey: 'events.event3.location', descriptionKey: 'events.event3.description' },
];

const HUBS = [
  { nameKey: 'regionalHubs.northAmerica.name', regionsKey: 'regionalHubs.northAmerica.regions' },
  { nameKey: 'regionalHubs.latinAmerica.name', regionsKey: 'regionalHubs.latinAmerica.regions' },
  { nameKey: 'regionalHubs.europe.name', regionsKey: 'regionalHubs.europe.regions' },
  { nameKey: 'regionalHubs.asiaPacific.name', regionsKey: 'regionalHubs.asiaPacific.regions' },
];
---

<Layout title="Soy Excellence Center - Empowering Soy Excellence">
  <!-- Hero Section with Carousel -->
  <HeroCarousel client:load />

  <!-- What We Offer Section -->
  <WhatWeOffer />

  <!-- Statistics and Testimonials Section -->
  <Statistics client:load />

  <!-- Upcoming Events Section -->
  <section id="upcoming-events" class="py-20 md:py-28 bg-forest text-white scroll-reveal-section">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8 items-end mb-14 scroll-reveal-item">
        <div>
          <span class="eyebrow mb-4">
            <span class="eyebrow-rule"></span>
            <span data-i18n="events.comingSoon">Coming Soon</span>
          </span>
          <h2 class="text-3xl md:text-5xl leading-[1.05]" data-i18n="events.title">
            Upcoming Events
          </h2>
        </div>
        <p class="text-lg text-white/60 leading-relaxed md:text-right" data-i18n="events.subtitle">
          Join us at our upcoming conferences, workshops, and training programs
        </p>
      </div>

      <div class="border-t border-white/15">
        {EVENTS.map((event, index) => (
          <a
            href="#all-events"
            class="scroll-reveal-item group flex flex-col md:flex-row md:items-center gap-4 md:gap-8 border-b border-white/15 py-7 hover:bg-white/[0.03] transition-colors duration-300 px-2 -mx-2"
            style={`transition-delay: ${index * 100}ms;`}
          >
            <div class="font-display font-bold text-sec-yellow text-2xl md:w-24 flex-shrink-0">
              {event.day} <span class="text-base text-white/50 align-middle">{event.month}</span>
            </div>
            <div class="flex-1">
              <h3 class="font-bold text-lg group-hover:text-sec-yellow transition-colors duration-300" data-i18n={event.titleKey}></h3>
              <p class="text-sm text-white/50 leading-relaxed" data-i18n={event.descriptionKey}></p>
            </div>
            <div class="flex items-center gap-2 text-sm text-white/60 md:w-48 flex-shrink-0">
              <MapPin size={14} class="text-sec-yellow" />
              <span data-i18n={event.locationKey}></span>
            </div>
            <ArrowRight size={18} class="hidden md:block text-white/30 group-hover:text-sec-yellow group-hover:translate-x-1 transition-all duration-300" />
          </a>
        ))}
      </div>

      <div class="mt-10 scroll-reveal-item" style="transition-delay: 400ms;">
        <a href="#all-events" class="btn-outline-light">
          <span data-i18n="events.viewAllEvents">View All Events</span>
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- Regional Hubs Preview Section -->
  <section id="regional-hubs" class="py-20 md:py-28 bg-white scroll-reveal-section">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mb-14 scroll-reveal-item">
        <span class="eyebrow mb-4">
          <span class="eyebrow-rule"></span>
          Global Presence
        </span>
        <h2 class="text-3xl md:text-5xl text-ink leading-[1.05] mb-4" data-i18n="regionalHubs.title">
          Our Global Presence
        </h2>
        <p class="text-lg text-ink/60 leading-relaxed" data-i18n="regionalHubs.subtitle">
          Connecting soy excellence across continents through our regional hubs
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-line">
        {HUBS.map((hub, index) => (
          <div
            class="scroll-reveal-item group border-r border-b border-line p-8 hover:bg-paper transition-colors duration-300"
            style={`transition-delay: ${index * 100}ms;`}
          >
            <div class="icon-tile mb-6 group-hover:border-ussec-green transition-colors duration-300">
              <Globe size={22} />
            </div>
            <h3 class="font-bold text-ink text-lg mb-1" data-i18n={hub.nameKey}></h3>
            <p class="text-sm text-ink/50" data-i18n={hub.regionsKey}></p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  let translations = {};
  let currentLanguage = 'en';

  // Load translations
  async function loadPageTranslations() {
    try {
      const lang = localStorage.getItem('preferredLanguage') || 'en';
      if (lang === currentLanguage && Object.keys(translations).length > 0) {
        return; // Already loaded
      }

      const response = await fetch('/i18n/translations.json');
      const data = await response.json();
      translations = data[lang] || {};
      currentLanguage = lang;
      applyPageTranslations();
    } catch (error) {
      console.error('Error loading translations:', error);
    }
  }

  // Apply translations to all elements
  function applyPageTranslations() {
    const elements = document.querySelectorAll('[data-i18n]');
    elements.forEach(element => {
      const key = element.getAttribute('data-i18n');
      if (translations[key]) {
        element.textContent = translations[key];
      }
    });
  }

  // Scroll reveal animation for sections
  function initScrollReveal() {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          // Stop observing once revealed
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Observe all scroll-reveal items
    const scrollItems = document.querySelectorAll('.scroll-reveal-item');
    scrollItems.forEach(item => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(40px)';
      item.style.transition = 'opacity 0.8s ease-out, transform 0.8s ease-out';
      observer.observe(item);
    });
  }

  // Initialize on page load
  function initPage() {
    loadPageTranslations();
    initScrollReveal();
  }

  // Listen for language changes
  window.addEventListener('languageChange', loadPageTranslations);

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
</script>

<style>
  .scroll-reveal-item.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>
