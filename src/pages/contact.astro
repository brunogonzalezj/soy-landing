---
import Layout from '../layouts/Layout.astro';
import { ArrowRight, Mail, Phone, MapPin, Check } from 'lucide-react';
---

<Layout title="Contact Us - Soy Excellence Center">
  <section class="py-20 md:py-28 bg-paper">
    <div class="container mx-auto px-4">
      {/* Header */}
      <div class="max-w-2xl mx-auto text-center mb-14 scroll-reveal-section">
        <span class="eyebrow justify-center mb-5">
          <span class="eyebrow-rule"></span>
          <span data-i18n="contactPage.badge">Get In Touch</span>
        </span>
        <h1 class="text-3xl md:text-5xl text-ink mb-6 leading-[1.05]" data-i18n="contactPage.title">
          Let's Start a Conversation
        </h1>
        <p class="text-lg text-ink/60 leading-relaxed" data-i18n="contactPage.subtitle">
          Tell us about yourself and your interests by completing the form below.
          Our team will review your information and a representative will reach out to you shortly.
        </p>
      </div>

      {/* Contact Form */}
      <div class="max-w-4xl mx-auto scroll-reveal-section">
        <div class="scroll-reveal-item bg-white border border-line p-8 md:p-14">
          <form id="contact-form" class="space-y-12">
            {/* Personal Information Section */}
            <div>
              <h2 class="text-2xl text-ink mb-6 flex items-center gap-4">
                <span class="w-9 h-9 flex items-center justify-center bg-ink text-sec-yellow font-display font-bold text-lg flex-shrink-0">1</span>
                <span data-i18n="contactPage.personalInfo">Personal Information</span>
              </h2>
              <div class="grid md:grid-cols-2 gap-6">
                {/* First Name */}
                <div>
                  <label for="firstName" class="block text-sm font-bold text-ink mb-2">
                    <span data-i18n="contactPage.firstName">First Name</span> <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    required
                    class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none"
                    placeholder="Enter your first name"
                    data-i18n-placeholder="contactPage.firstNamePlaceholder"
                  />
                </div>

                {/* Last Name */}
                <div>
                  <label for="lastName" class="block text-sm font-bold text-ink mb-2">
                    <span data-i18n="contactPage.lastName">Last Name</span> <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    required
                    class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none"
                    placeholder="Enter your last name"
                    data-i18n-placeholder="contactPage.lastNamePlaceholder"
                  />
                </div>

                {/* Email */}
                <div>
                  <label for="email" class="block text-sm font-bold text-ink mb-2">
                    <span data-i18n="contactPage.email">Email Address</span> <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none"
                    placeholder="your.email@example.com"
                    data-i18n-placeholder="contactPage.emailPlaceholder"
                  />
                </div>

                {/* Phone Number */}
                <div>
                  <label for="phone" class="block text-sm font-bold text-ink mb-2">
                    <span data-i18n="contactPage.phone">Phone Number</span>
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none"
                    placeholder="+1 (555) 123-4567"
                    data-i18n-placeholder="contactPage.phonePlaceholder"
                  />
                </div>

                {/* Region */}
                <div class="md:col-span-2">
                  <label for="region" class="block text-sm font-bold text-ink mb-2">
                    <span data-i18n="contactPage.region">Region</span> <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="region"
                    name="region"
                    required
                    class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none bg-white"
                  >
                    <option value="" data-i18n="contactPage.selectRegion">Select your region</option>
                    <option value="north-america" selected data-i18n="contactPage.regionNorthAmerica">North America</option>
                    <option value="latin-america" data-i18n="contactPage.regionLatinAmerica">Latin America</option>
                    <option value="europe-mena" data-i18n="contactPage.regionEuropeMena">Europe & Middle East / North Africa</option>
                    <option value="asia-pacific" data-i18n="contactPage.regionAsiaPacific">Asia Pacific</option>
                    <option value="southeast-asia" data-i18n="contactPage.regionSoutheastAsia">Southeast Asia</option>
                    <option value="other" data-i18n="contactPage.regionOther">Other</option>
                  </select>
                </div>
              </div>
            </div>

            {/* Company Information Section */}
            <div>
              <h2 class="text-2xl text-ink mb-6 flex items-center gap-4">
                <span class="w-9 h-9 flex items-center justify-center bg-ink text-sec-yellow font-display font-bold text-lg flex-shrink-0">2</span>
                <span data-i18n="contactPage.companyInfo">Company Information</span>
              </h2>
              <div class="grid md:grid-cols-2 gap-6">
                {/* Company Name */}
                <div>
                  <label for="companyName" class="block text-sm font-bold text-ink mb-2">
                    <span data-i18n="contactPage.companyName">Company Name</span>
                  </label>
                  <input
                    type="text"
                    id="companyName"
                    name="companyName"
                    class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none"
                    placeholder="Your company name"
                    data-i18n-placeholder="contactPage.companyNamePlaceholder"
                  />
                </div>

                {/* Role */}
                <div>
                  <label for="role" class="block text-sm font-bold text-ink mb-2">
                    <span data-i18n="contactPage.role">Your Role</span> <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="role"
                    name="role"
                    required
                    class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none bg-white"
                  >
                    <option value="" data-i18n="contactPage.selectRole">Select your role</option>
                    <option value="employer" data-i18n="contactPage.roleEmployer">Employer</option>
                    <option value="participant" data-i18n="contactPage.roleParticipant">Participant</option>
                    <option value="partner" data-i18n="contactPage.rolePartner">Partner</option>
                    <option value="other" data-i18n="contactPage.roleOther">Other</option>
                  </select>
                </div>

                {/* Company Type */}
                <div class="md:col-span-2">
                  <label for="companyType" class="block text-sm font-bold text-ink mb-2">
                    <span data-i18n="contactPage.companyType">Industry / Company Type</span>
                  </label>
                  <input
                    type="text"
                    id="companyType"
                    name="companyType"
                    class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none"
                    placeholder="e.g., Feed Manufacturer, Aquaculture, Livestock Producer"
                    data-i18n-placeholder="contactPage.companyTypePlaceholder"
                  />
                </div>
              </div>
            </div>

            {/* How Can We Help Section */}
            <div>
              <h2 class="text-2xl text-ink mb-6 flex items-center gap-4">
                <span class="w-9 h-9 flex items-center justify-center bg-ink text-sec-yellow font-display font-bold text-lg flex-shrink-0">3</span>
                <span data-i18n="contactPage.howCanWeHelp.title">How Can We Help You?</span>
              </h2>
              <p class="text-ink/60 mb-6" data-i18n="contactPage.howCanWeHelp.subtitle">Please select one option that best describes your inquiry:</p>

              <div class="space-y-3">
                {/* Option 1 */}
                <label class="flex items-start gap-4 p-4 border border-line hover:border-ussec-green cursor-pointer transition-colors duration-300 group">
                  <input
                    type="radio"
                    name="helpOption"
                    value="training-events"
                    class="mt-1 w-4 h-4 accent-ussec-green"
                  />
                  <div class="flex-1">
                    <span class="font-bold text-ink" data-i18n="contactPage.helpOption1.title">Training Events</span>
                    <p class="text-sm text-ink/60 mt-1" data-i18n="contactPage.helpOption1.description">I would like more information about upcoming training events in my region</p>
                  </div>
                </label>

                {/* Option 2 */}
                <label class="flex items-start gap-4 p-4 border border-line hover:border-ussec-green cursor-pointer transition-colors duration-300 group">
                  <input
                    type="radio"
                    name="helpOption"
                    value="stay-engaged"
                    class="mt-1 w-4 h-4 accent-ussec-green"
                  />
                  <div class="flex-1">
                    <span class="font-bold text-ink" data-i18n="contactPage.helpOption2.title">Stay Engaged</span>
                    <p class="text-sm text-ink/60 mt-1" data-i18n="contactPage.helpOption2.description">I am a past participant and want to stay engaged with the community</p>
                  </div>
                </label>

                {/* Option 3 */}
                <label class="flex items-start gap-4 p-4 border border-line hover:border-ussec-green cursor-pointer transition-colors duration-300 group">
                  <input
                    type="radio"
                    name="helpOption"
                    value="talent-development"
                    class="mt-1 w-4 h-4 accent-ussec-green"
                  />
                  <div class="flex-1">
                    <span class="font-bold text-ink" data-i18n="contactPage.helpOption3.title">Talent Development</span>
                    <p class="text-sm text-ink/60 mt-1" data-i18n="contactPage.helpOption3.description">I am an employer looking for talent development solutions for my business</p>
                  </div>
                </label>

                {/* Option 4 */}
                <label class="flex items-start gap-4 p-4 border border-line hover:border-ussec-green cursor-pointer transition-colors duration-300 group">
                  <input
                    type="radio"
                    name="helpOption"
                    value="bring-programming"
                    class="mt-1 w-4 h-4 accent-ussec-green"
                  />
                  <div class="flex-1">
                    <span class="font-bold text-ink" data-i18n="contactPage.helpOption4.title">Bring Programming</span>
                    <p class="text-sm text-ink/60 mt-1" data-i18n="contactPage.helpOption4.description">I am interested in bringing Soy Excellence Center programming to my country</p>
                  </div>
                </label>

                {/* Option 5 */}
                <label class="flex items-start gap-4 p-4 border border-line hover:border-ussec-green cursor-pointer transition-colors duration-300 group">
                  <input
                    type="radio"
                    name="helpOption"
                    value="partnership"
                    class="mt-1 w-4 h-4 accent-ussec-green"
                  />
                  <div class="flex-1">
                    <span class="font-bold text-ink" data-i18n="contactPage.helpOption5.title">Partnership</span>
                    <p class="text-sm text-ink/60 mt-1" data-i18n="contactPage.helpOption5.description">I want to learn more about partnering with the Soy Excellence Center</p>
                  </div>
                </label>

                {/* Option 6 - Other */}
                <label class="flex items-start gap-4 p-4 border border-line hover:border-ussec-green cursor-pointer transition-colors duration-300 group">
                  <input
                    type="radio"
                    name="helpOption"
                    value="other"
                    class="mt-1 w-4 h-4 accent-ussec-green"
                  />
                  <div class="flex-1">
                    <span class="font-bold text-ink">Other</span>
                    <p class="text-sm text-ink/60 mt-1">I have a different inquiry (please explain below)</p>
                  </div>
                </label>
              </div>

              {/* Additional Comments */}
              <div class="mt-6">
                <label for="message" class="block text-sm font-bold text-ink mb-2">
                  Additional Comments
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none resize-none"
                  placeholder="Please provide any additional details about your inquiry..."
                ></textarea>
              </div>
            </div>

            {/* Submit Button */}
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-8 border-t border-line">
              <button type="submit" class="btn-primary w-full sm:w-auto">
                <span>Submit Inquiry</span>
                <ArrowRight size={16} />
              </button>
              <button
                type="reset"
                class="w-full sm:w-auto px-7 py-3.5 border border-line text-ink font-bold text-sm uppercase tracking-wide hover:border-ink transition-colors duration-300"
              >
                Clear Form
              </button>
            </div>

            <p class="text-center text-sm text-ink/50">
              <span class="text-red-500">*</span> Required fields
            </p>
          </form>

          {/* Success Message (hidden by default) */}
          <div id="success-message" class="hidden text-center py-12">
            <div class="w-16 h-16 flex items-center justify-center bg-ussec-green/10 mx-auto mb-6">
              <Check size={32} class="text-ussec-green" />
            </div>
            <h3 class="text-2xl text-ink mb-3">Thank You!</h3>
            <p class="text-ink/60">Your inquiry has been submitted successfully. A representative will follow up with you shortly.</p>
          </div>
        </div>
      </div>

      {/* Additional Contact Information */}
      <div class="max-w-4xl mx-auto mt-16 scroll-reveal-section">
        <div class="grid md:grid-cols-3 border-t border-l border-line">
          <div class="scroll-reveal-item border-r border-b border-line p-8 text-center">
            <div class="icon-tile mx-auto mb-4">
              <Mail size={20} />
            </div>
            <h3 class="font-bold text-ink mb-2" data-i18n="contactPage.contactInfo.email">Email Us</h3>
            <a href="mailto:info@soyexcellence.org" class="link-underline text-ink/60 hover:text-ussec-green transition-colors">
              info@soyexcellence.org
            </a>
          </div>

          <div class="scroll-reveal-item border-r border-b border-line p-8 text-center" style="transition-delay: 150ms;">
            <div class="icon-tile mx-auto mb-4">
              <Phone size={20} />
            </div>
            <h3 class="font-bold text-ink mb-2" data-i18n="contactPage.contactInfo.phone">Call Us</h3>
            <a href="tel:+1-555-123-4567" class="link-underline text-ink/60 hover:text-ussec-green transition-colors">
              +1 (555) 123-4567
            </a>
          </div>

          <div class="scroll-reveal-item border-r border-b border-line p-8 text-center" style="transition-delay: 300ms;">
            <div class="icon-tile mx-auto mb-4">
              <MapPin size={20} />
            </div>
            <h3 class="font-bold text-ink mb-2" data-i18n="contactPage.contactInfo.visit">Visit Us</h3>
            <p class="text-ink/60">
              <span data-i18n="contactPage.contactInfo.headquarters">Global Headquarters</span><br><span data-i18n="contactPage.contactInfo.location">Washington, D.C.</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  let translations = {};
  let currentLanguage = 'en';

  // Load translations
  async function loadPageTranslations() {
    try {
      const lang = localStorage.getItem('preferredLanguage') || 'en';
      if (lang === currentLanguage && Object.keys(translations).length > 0) {
        return; // Already loaded
      }

      const response = await fetch('/i18n/translations.json');
      const data = await response.json();
      translations = data[lang] || {};
      currentLanguage = lang;
      applyPageTranslations();
    } catch (error) {
      console.error('Error loading translations:', error);
    }
  }

  // Apply translations to all elements
  function applyPageTranslations() {
    const elements = document.querySelectorAll('[data-i18n]');
    elements.forEach(element => {
      const key = element.getAttribute('data-i18n');
      if (translations[key]) {
        element.textContent = translations[key];
      }
    });

    // Handle placeholders
    const placeholderElements = document.querySelectorAll('[data-i18n-placeholder]');
    placeholderElements.forEach(element => {
      const key = element.getAttribute('data-i18n-placeholder');
      if (translations[key]) {
        element.placeholder = translations[key];
      }
    });
  }

  function initScrollReveal() {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const scrollItems = document.querySelectorAll('.scroll-reveal-item');
    scrollItems.forEach(item => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(40px)';
      item.style.transition = 'opacity 0.8s ease-out, transform 0.8s ease-out';
      observer.observe(item);
    });
  }

  // Form submission handler
  const contactForm = document.getElementById('contact-form');
  const successMessage = document.getElementById('success-message');

  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();

      // Here you would typically send the form data to a server
      // For now, we'll just show the success message
      contactForm.classList.add('hidden');
      successMessage.classList.remove('hidden');

      // Scroll to success message
      successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }

  // Initialize on page load
  function initPage() {
    loadPageTranslations();
    initScrollReveal();
  }

  // Listen for language changes
  window.addEventListener('languageChange', loadPageTranslations);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
</script>

<style>
  .scroll-reveal-item.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  /* Selected state for radio labels */
  label:has(input[type="radio"]:checked) {
    border-color: var(--color-ussec-green) !important;
    background-color: color-mix(in srgb, var(--color-ussec-green) 5%, white);
  }
</style>
