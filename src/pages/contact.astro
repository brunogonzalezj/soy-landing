---
import Layout from '../layouts/Layout.astro';
import { ArrowRight, Mail, Phone, MapPin, Check } from 'lucide-react';

const COUNTRY_GROUPS = [
  {
    region: 'Americas',
    countries: ['United States', 'Canada', 'Mexico', 'Brazil', 'Argentina', 'Colombia', 'Peru', 'Chile', 'Ecuador', 'Bolivia', 'Paraguay', 'Uruguay', 'Costa Rica', 'Guatemala', 'Honduras', 'Dominican Republic'],
  },
  {
    region: 'Asia',
    countries: ['China', 'Japan', 'South Korea', 'Vietnam', 'Thailand', 'Philippines', 'Indonesia', 'Malaysia', 'Taiwan', 'Singapore'],
  },
  {
    region: 'India',
    countries: ['India'],
  },
  {
    region: 'MENA',
    countries: ['Egypt', 'Morocco', 'Saudi Arabia', 'United Arab Emirates', 'Jordan', 'Tunisia', 'Algeria', 'Turkey'],
  },
  {
    region: 'SSA',
    countries: ['Nigeria', 'Kenya', 'South Africa', 'Ghana', 'Ethiopia', 'Tanzania', 'Uganda', 'Senegal'],
  },
];
---

<Layout title="Contact Us - Soy Excellence Center">
  <section class="py-20 md:py-28 bg-paper">
    <div class="container mx-auto px-4">
      {/* Header */}
      <div class="max-w-2xl mx-auto text-center mb-14 scroll-reveal-section">
        <span class="eyebrow justify-center mb-5">
          <span class="eyebrow-rule"></span>
          <span data-i18n="contactPage.badge">Get In Touch</span>
        </span>
        <h1 class="text-3xl md:text-5xl text-ink mb-6 leading-[1.05]" data-i18n="contactPage.title">
          Let's Start a Conversation
        </h1>
        <p class="text-lg text-ink/60 leading-relaxed" data-i18n="contactPage.subtitle">
          Tell us about yourself and your interests by completing the form below.
          Our team will review your information and a representative will reach out to you shortly.
        </p>
      </div>

      {/* Contact Form */}
      <div class="max-w-2xl mx-auto scroll-reveal-section">
        <div class="scroll-reveal-item bg-white border border-line p-8 md:p-14">
          <form id="contact-form" class="space-y-6">
            {/* First Name */}
            <div>
              <label for="firstName" class="block text-sm font-bold text-ink mb-2">
                <span data-i18n="contactPage.firstName">First Name</span> <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none"
                placeholder="Enter your first name"
                data-i18n-placeholder="contactPage.firstNamePlaceholder"
              />
            </div>

            {/* Last Name */}
            <div>
              <label for="lastName" class="block text-sm font-bold text-ink mb-2">
                <span data-i18n="contactPage.lastName">Last Name</span> <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                required
                class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none"
                placeholder="Enter your last name"
                data-i18n-placeholder="contactPage.lastNamePlaceholder"
              />
            </div>

            {/* Email */}
            <div>
              <label for="email" class="block text-sm font-bold text-ink mb-2">
                <span data-i18n="contactPage.email">Email Address</span> <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none"
                placeholder="your.email@example.com"
                data-i18n-placeholder="contactPage.emailPlaceholder"
              />
            </div>

            {/* Country */}
            <div>
              <label for="country" class="block text-sm font-bold text-ink mb-2">
                <span data-i18n="contactPage.country">Country</span> <span class="text-red-500">*</span>
              </label>
              <select
                id="country"
                name="country"
                required
                class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none bg-white"
              >
                <option value="" data-i18n="contactPage.selectCountry">Select your country</option>
                {COUNTRY_GROUPS.map((group) => (
                  <optgroup label={group.region}>
                    {group.countries.map((country) => (
                      <option value={country}>{country}</option>
                    ))}
                  </optgroup>
                ))}
                <optgroup label="Other">
                  <option value="Other">Other</option>
                </optgroup>
              </select>
              {/* Region is derived automatically from the selected country's group above and is not shown to the user */}
              <input type="hidden" id="region" name="region" />
            </div>

            {/* Message */}
            <div>
              <label for="message" class="block text-sm font-bold text-ink mb-2">
                <span data-i18n="contactPage.message">Message</span> <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-sm border border-line focus:border-ussec-green focus:ring-1 focus:ring-ussec-green transition-all duration-300 outline-none resize-none"
                placeholder="Please provide any additional details about your inquiry..."
                data-i18n-placeholder="contactPage.messagePlaceholder"
              ></textarea>
            </div>

            {/* Submit Button */}
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-6 border-t border-line">
              <button type="submit" class="btn-primary w-full sm:w-auto">
                <span data-i18n="contactPage.submit">Submit Inquiry</span>
                <ArrowRight size={16} />
              </button>
              <button
                type="reset"
                class="w-full sm:w-auto px-7 py-3.5 border border-line text-ink font-bold text-sm uppercase tracking-wide hover:border-ink transition-colors duration-300"
              >
                <span data-i18n="contactPage.clear">Clear Form</span>
              </button>
            </div>

            <p class="text-center text-sm text-ink/50">
              <span class="text-red-500">*</span> <span data-i18n="contactPage.required">Required fields</span>
            </p>
          </form>

          {/* Success Message (hidden by default) */}
          <div id="success-message" class="hidden text-center py-12">
            <div class="w-16 h-16 flex items-center justify-center bg-ussec-green/10 mx-auto mb-6">
              <Check size={32} class="text-ussec-green" />
            </div>
            <h3 class="text-2xl text-ink mb-3" data-i18n="contactPage.success.title">Thank You!</h3>
            <p class="text-ink/60" data-i18n="contactPage.success.message">Your inquiry has been submitted successfully. A representative will follow up with you shortly.</p>
          </div>
        </div>
      </div>

      {/* Additional Contact Information */}
      <div class="max-w-4xl mx-auto mt-16 scroll-reveal-section">
        <div class="grid md:grid-cols-3 border-t border-l border-line">
          <div class="scroll-reveal-item border-r border-b border-line p-8 text-center">
            <div class="icon-tile mx-auto mb-4">
              <Mail size={20} />
            </div>
            <h3 class="font-bold text-ink mb-2" data-i18n="contactPage.contactInfo.email">Email Us</h3>
            <a href="mailto:info@soyexcellence.org" class="link-underline text-ink/60 hover:text-ussec-green transition-colors">
              info@soyexcellence.org
            </a>
          </div>

          <div class="scroll-reveal-item border-r border-b border-line p-8 text-center" style="transition-delay: 150ms;">
            <div class="icon-tile mx-auto mb-4">
              <Phone size={20} />
            </div>
            <h3 class="font-bold text-ink mb-2" data-i18n="contactPage.contactInfo.phone">Call Us</h3>
            <a href="tel:+1-555-123-4567" class="link-underline text-ink/60 hover:text-ussec-green transition-colors">
              +1 (555) 123-4567
            </a>
          </div>

          <div class="scroll-reveal-item border-r border-b border-line p-8 text-center" style="transition-delay: 300ms;">
            <div class="icon-tile mx-auto mb-4">
              <MapPin size={20} />
            </div>
            <h3 class="font-bold text-ink mb-2" data-i18n="contactPage.contactInfo.visit">Visit Us</h3>
            <p class="text-ink/60">
              <span data-i18n="contactPage.contactInfo.headquarters">Global Headquarters</span><br><span data-i18n="contactPage.contactInfo.location">Washington, D.C.</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import translationsData from '../i18n/translations.json';

  let translations = {};

  // Apply translations (bundled at build time, no network round trip)
  function loadPageTranslations() {
    const lang = localStorage.getItem('preferredLanguage') || 'en';
    translations = translationsData[lang] || {};
    applyPageTranslations();
  }

  // Apply translations to all elements
  function applyPageTranslations() {
    const elements = document.querySelectorAll('[data-i18n]');
    elements.forEach(element => {
      const key = element.getAttribute('data-i18n');
      if (translations[key]) {
        element.textContent = translations[key];
      }
    });

    // Handle placeholders
    const placeholderElements = document.querySelectorAll('[data-i18n-placeholder]');
    placeholderElements.forEach(element => {
      const key = element.getAttribute('data-i18n-placeholder');
      if (translations[key]) {
        element.placeholder = translations[key];
      }
    });
  }

  function initScrollReveal() {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const scrollItems = document.querySelectorAll('.scroll-reveal-item');
    scrollItems.forEach(item => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(40px)';
      item.style.transition = 'opacity 0.8s ease-out, transform 0.8s ease-out';
      observer.observe(item);
    });
  }

  // Auto-fill the hidden region field based on the selected country's group
  const countrySelect = document.getElementById('country');
  const regionInput = document.getElementById('region');

  if (countrySelect && regionInput) {
    countrySelect.addEventListener('change', () => {
      const selectedOption = countrySelect.options[countrySelect.selectedIndex];
      const group = selectedOption?.parentElement;
      regionInput.value = group && group.tagName === 'OPTGROUP' ? group.label : '';
    });
  }

  // Form submission handler
  const contactForm = document.getElementById('contact-form');
  const successMessage = document.getElementById('success-message');

  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();

      // Here you would typically send the form data to a server
      // For now, we'll just show the success message
      contactForm.classList.add('hidden');
      successMessage.classList.remove('hidden');

      // Scroll to success message
      successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }

  // Initialize on page load
  function initPage() {
    loadPageTranslations();
    initScrollReveal();
  }

  // Listen for language changes
  window.addEventListener('languageChange', loadPageTranslations);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
</script>

<style>
  .scroll-reveal-item.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>
