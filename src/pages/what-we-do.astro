---
import Layout from '../layouts/Layout.astro';
import { Target, Wheat, PiggyBank, FlaskConical } from 'lucide-react';

const PROGRAMS = [
  {
    number: '01',
    titleKey: 'whatWeDo.programs.feedManufacturing.title',
    descriptionKey: 'whatWeDo.programs.feedManufacturing.description',
    icon: Wheat,
  },
  {
    number: '02',
    titleKey: 'whatWeDo.programs.animalProduction.title',
    descriptionKey: 'whatWeDo.programs.animalProduction.description',
    icon: PiggyBank,
  },
  {
    number: '03',
    titleKey: 'whatWeDo.programs.soyFoods.title',
    regionsKey: 'whatWeDo.programs.soyFoods.regions',
    descriptionKey: 'whatWeDo.programs.soyFoods.description',
    icon: FlaskConical,
  },
];
---

<Layout title="What We Do - Soy Excellence Center">
  <section class="py-20 md:py-28 bg-white">
    <div class="container mx-auto px-4">
      {/* Header */}
      <div class="max-w-3xl mb-16 md:mb-20 scroll-reveal-section">
        <span class="eyebrow mb-5">
          <span class="eyebrow-rule"></span>
          <span data-i18n="whatWeDo.badge">About SEC</span>
        </span>
        <h1 class="text-4xl md:text-6xl text-ink mb-6 leading-[1.05]" data-i18n="whatWeDo.title">
          What We Do
        </h1>
        <p class="text-lg md:text-xl text-ink/60 leading-relaxed" data-i18n="whatWeDo.subtitle">
          Facilitating training and continuing education that helps professionals overcome key challenges across the food and agribusiness sectors.
        </p>
      </div>

      {/* Mission, Vision & Strategy */}
      <div class="mb-20 md:mb-28 scroll-reveal-section">
        <div class="grid md:grid-cols-2 border-t border-line">
          <div class="scroll-reveal-item border-b md:border-r border-line p-8 md:p-10">
            <div class="icon-tile mb-6">
              <Target size={22} />
            </div>
            <h2 class="text-2xl text-ink mb-4" data-i18n="whatWeDo.mission">Our Mission</h2>
            <p class="text-ink/60 leading-relaxed mb-10" data-i18n="whatWeDo.missionContent">
              To facilitate employee training and continuing education activities that provide the knowledge and skills necessary to help employees overcome key challenges and operational obstacles in the food and agribusiness sectors.
            </p>
            <h3 class="text-xl text-ink mb-3" data-i18n="whatWeDo.vision.title">Our Vision</h3>
            <p class="text-ink/60 leading-relaxed" data-i18n="whatWeDo.vision.content">
              To envision a future where U.S. Soy is recognized worldwide as a catalyst for positive change, helping build prosperous agrifood markets, stronger businesses, and greater opportunities for people to grow and succeed.
            </p>
          </div>
          <div class="scroll-reveal-item border-b border-line p-8 md:p-10 bg-paper" style="transition-delay: 150ms;">
            <h3 class="text-xl text-ink mb-4" data-i18n="whatWeDo.strategy">Our Strategy</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-ink/70">
                <span class="block w-1.5 h-1.5 bg-sec-yellow mt-2.5 flex-shrink-0"></span>
                <span data-i18n="whatWeDo.strategy1">Provide world-class education and training programs</span>
              </li>
              <li class="flex items-start gap-3 text-ink/70">
                <span class="block w-1.5 h-1.5 bg-sec-yellow mt-2.5 flex-shrink-0"></span>
                <span data-i18n="whatWeDo.strategy2">Build strong partnerships across the soy value chain</span>
              </li>
              <li class="flex items-start gap-3 text-ink/70">
                <span class="block w-1.5 h-1.5 bg-sec-yellow mt-2.5 flex-shrink-0"></span>
                <span data-i18n="whatWeDo.strategy3">Strengthen technical capacity and workforce development</span>
              </li>
              <li class="flex items-start gap-3 text-ink/70">
                <span class="block w-1.5 h-1.5 bg-sec-yellow mt-2.5 flex-shrink-0"></span>
                <span data-i18n="whatWeDo.strategy4">Create opportunities for professional growth and industry leadership</span>
              </li>
              <li class="flex items-start gap-3 text-ink/70">
                <span class="block w-1.5 h-1.5 bg-sec-yellow mt-2.5 flex-shrink-0"></span>
                <span data-i18n="whatWeDo.strategy5">Promote greater understanding, confidence, and preference for U.S. Soy</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      {/* Continued Education Programs */}
      <div class="scroll-reveal-section">
        <div class="max-w-2xl mb-12 scroll-reveal-item">
          <span class="eyebrow mb-4">
            <span class="eyebrow-rule"></span>
            <span data-i18n="whatWeDo.programs.badge">Programs</span>
          </span>
          <h2 class="text-3xl md:text-4xl text-ink mb-4" data-i18n="whatWeDo.programs.title">Continued Education Programs</h2>
          <p class="text-lg text-ink/60" data-i18n="whatWeDo.programs.subtitle">
            Track-specific curricula that build technical and managerial capabilities across the soy value chain.
          </p>
        </div>

        <div class="grid md:grid-cols-3 border-t border-l border-line">
          {PROGRAMS.map((program, index) => {
            const Icon = program.icon;
            return (
              <div
                class="scroll-reveal-item border-r border-b border-line p-8"
                style={`transition-delay: ${index * 100}ms;`}
              >
                <div class="flex items-start justify-between mb-6">
                  <span class="index-num text-3xl">{program.number}</span>
                  <div class="icon-tile">
                    <Icon size={22} />
                  </div>
                </div>
                <h3 class="text-xl font-bold text-ink mb-1" data-i18n={program.titleKey}></h3>
                {program.regionsKey && (
                  <p class="text-xs font-bold uppercase tracking-wide text-ussec-green mb-3" data-i18n={program.regionsKey}></p>
                )}
                <p class={`text-ink/60 leading-relaxed text-sm ${!program.regionsKey ? 'mt-1' : ''}`} data-i18n={program.descriptionKey}></p>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import translationsData from '../i18n/translations.json';

  let translations = {};

  // Apply translations (bundled at build time, no network round trip)
  function loadPageTranslations() {
    const lang = localStorage.getItem('preferredLanguage') || 'en';
    translations = translationsData[lang] || {};
    applyPageTranslations();
  }

  // Apply translations to all elements
  function applyPageTranslations() {
    const elements = document.querySelectorAll('[data-i18n]');
    elements.forEach(element => {
      const key = element.getAttribute('data-i18n');
      if (translations[key]) {
        element.textContent = translations[key];
      }
    });
  }

  function initScrollReveal() {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const scrollItems = document.querySelectorAll('.scroll-reveal-item');
    scrollItems.forEach(item => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(40px)';
      item.style.transition = 'opacity 0.8s ease-out, transform 0.8s ease-out';
      observer.observe(item);
    });
  }

  // Initialize on page load
  function initPage() {
    loadPageTranslations();
    initScrollReveal();
  }

  // Listen for language changes
  window.addEventListener('languageChange', loadPageTranslations);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
</script>

<style>
  .scroll-reveal-item.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>
